# Home Assistant host configuration
HASS_PORT=8123
HASS_CONFIG_DIR=./config
HASS_BACKUP_DIR=./backups

# macOS host-side ZBT-2 serial bridge
ZBT2_SERIAL_URL=rfc2217://host.docker.internal:6638

# Private Home Sweet Home Agent endpoint
HSH_AGENT_URL=http://home-sweet-home-agent:3400

# Optional external integrations should be configured through secrets.yaml or
# a deployment secret manager. Never commit credentials here.
